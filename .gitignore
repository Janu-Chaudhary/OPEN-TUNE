build/
cmake-build-*/
.cache/
compile_commands.json
*.o
*.a
*.so
*.wav
!tests/fixtures/*.wav
.vscode/
.idea/
.DS_Store
.venv/

# Agent skills are per-developer tooling, installed not committed -- the same
# treatment as .venv above. skills-lock.json IS tracked and pins the exact
# source and content hash of each one, so `npx skills install` reproduces the
# set exactly. Keeping the skill bodies out of the repo also means installing
# a skill is never an act of redistributing someone else's file, whatever
# licence it carries.
.agents/
.claude/skills/
.superpowers/

# Editor lock/swap files
.~lock.*#
*.swp
*~
build-*/

# Reference audio for T1.0. Never committed: the owner's own recordings are
# personal, film-song covers carry the original composition's copyright, and
# .wav is binary that poisons an agent's context if read directly (CLAUDE.md).
# Provenance and derived f0 labels live in testdata/vocals/MANIFEST.md, which
# IS tracked - the labels are text and are what the measurements cite.
testdata/vocals/*.wav
testdata/vocals/*.mp4

# Synthetic ground-truth voices for T1.0 (tools/synth_voices.py). Regenerated
# in seconds from the committed script, so the audio is derived, not source --
# and .wav is binary that poisons an agent's context if read directly
# (CLAUDE.md). The .f0.csv label tracks and the MANIFEST ARE tracked: they are
# text, they are the ground truth, and they are what the measurements cite.
testdata/synthetic/*.wav

# Python bytecode left by the analysis tooling
__pycache__/
*.pyc
